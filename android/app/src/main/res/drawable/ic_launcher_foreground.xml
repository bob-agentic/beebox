<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icons crop to whatever shape the launcher picks, so the mark
     stays well inside the 66dp safe zone of the 108dp canvas.

     The translate is arithmetic, not taste: the source art is 128 wide, so at
     0.5 scale it occupies 64, and centring it in 108 needs (108-64)/2 = 22.
     An earlier 27 was eyeballed, and put the hexagon visibly up and to the
     left in the launcher. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <group android:scaleX="0.5" android:scaleY="0.5"
           android:translateX="22" android:translateY="22">
        <path android:pathData="M64,16 L105.57,40 L105.57,88 L64,112 L22.43,88 L22.43,40 Z"
              android:strokeColor="#4ade80" android:strokeWidth="4" />
        <path android:pathData="M64,34 L89.98,49 L89.98,79 L64,94 L38.02,79 L38.02,49 Z"
              android:fillColor="#4ade80" android:fillAlpha="0.16" />
        <path android:pathData="M45.1,53.2 L58.6,64 L45.1,74.8"
              android:strokeColor="#4ade80" android:strokeWidth="6"
              android:strokeLineCap="round" android:strokeLineJoin="round" />
        <path android:pathData="M64.9,71.8 L82.9,71.8"
              android:strokeColor="#4ade80" android:strokeWidth="6"
              android:strokeLineCap="round" />
    </group>
</vector>
