<?xml version="1.0" encoding="utf-8"?>
<!-- The daemon listens on a LAN address over plain HTTP, and always will:
     no certificate authority will issue for 192.168.x.x, and there is no
     domain to put in front of it. Android has blocked cleartext by default
     since 9, so it has to be permitted here or nothing connects.

     This is a blanket permit, deliberately. An earlier attempt listed the
     private ranges as <domain> entries — 192.168.0.0/16 and friends — which
     silently does nothing: <domain> matches hostnames, not CIDR blocks, and
     Android offers no way to scope cleartext by address range. The choice is
     all or nothing, and "nothing" means the app cannot reach its own daemon.

     What bounds the risk is that every URL comes from a share link the user
     scanned or pasted: the app never navigates anywhere on its own, and
     off-origin links are handed to the browser rather than loaded here. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
